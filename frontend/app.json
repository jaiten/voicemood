{
  "expo": {
    "name": "VoiceMood",
    "slug": "voicemood",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow VoiceMood to record voice journal entries."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.voicemood"
    },
    "android": {
      "package": "com.example.voicemood"
    }
  }
}
